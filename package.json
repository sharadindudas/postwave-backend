{
  "name": "postwave-backend",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "bun --watch src/index.ts",
    "check": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --out-dir dist",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@upstash/redis": "^1.36.2",
    "better-auth": "^1.4.19",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "postgres": "^3.4.8",
    "resend": "^6.9.2",
    "valibot": "^1.2.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "drizzle-kit": "^0.31.9",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
