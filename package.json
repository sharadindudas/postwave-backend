{
  "name": "postwave-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "bun src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write .",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start:prod": "bun dist/index.js",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "drizzle-kit": "^0.31.9",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@upstash/redis": "^1.36.2",
    "better-auth": "^1.4.19",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "postgres": "^3.4.8",
    "resend": "^6.9.2",
    "valibot": "^1.2.0",
    "winston": "^3.19.0"
  }
}
